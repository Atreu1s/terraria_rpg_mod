Awakening: {
	rogue: {
		Name: Lord of Shadows
		Effect: Every 8th rogue hit releases a fan of 3 homing shadow daggers for 60% damage each
		Bonus: Assassin: daggers for 100% damage · Trickster: every 5th hit
	}

	warrior: {
		Name: Avatar of War
		Effect: Hits build Fervor; when full, 8 s of +30% damage and +20% attack speed
		Bonus: Berserker: 2% lifesteal · Guardian: +15% damage reduction
	}

	ranger: {
		Name: Eye of the Storm
		Effect: Every 10th shot fires a homing projectile for 300% damage
		Bonus: Sniper: every 6th · Gunner: 3 projectiles for 100%
	}

	mage: {
		Name: Archmage
		Effect: When mana runs out, 5 s of infinite mana; 45 s cooldown
		Bonus: Arcanist: +25% damage meanwhile · Mystic: heals 20% life
	}

	summoner: {
		Name: Lord of Spirits
		Effect: +1 minion slot; minions crit with your crit chance
		Bonus: Swarm Lord: +1 more slot · Beastmaster: minion crits ×2.5
	}
}

Items: {
	AwakeningEssence: {
		DisplayName: Awakening Essence
		Tooltip: A personal essence from a fallen post-Moon Lord boss
	}

	AwakeningStone: {
		DisplayName: Awakening Stone
		Tooltip:
			'''
			Awakens your chosen class
			Requires a selected tier-3 node; cannot be used while awakened
			'''
	}

	StatResetItem: {
		DisplayName: Stat Reset
		Tooltip: Refunds all manually assigned stat points
	}

	TreeResetItem: {
		DisplayName: Tree Reset
		Tooltip: Resets your class and skill tree; returns an Awakening Stone if awakened
	}
}

Projectiles: {
	ShadowDagger.DisplayName: Shadow Dagger
	AwakeningBolt.DisplayName: Storm Eye
}

Awakening2: {
	Fervor: Fervor
	Awakened: Awakened: {0}!
	ThreeSources: Obtain essences from at least three different bosses
	RecipeHint: Awakening Stone: 3 Awakening Essence + 10 Divine Geode + 3 Armored Shell + 3 Dark Plasma + 3 Twisting Nether, at an Ancient Manipulator. Requires essences from three different bosses.
	StatsReset: Your assigned stat points have been refunded.
	TreeReset: Your class and skill tree have been reset.
	TreeResetRefund: Your class and skill tree have been reset. Your Awakening Stone has been returned.
}
