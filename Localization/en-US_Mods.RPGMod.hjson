Nodes: {
	rogue: {
		Name: Rogue
		Effect: +5% rogue damage, +5% rogue critical strike chance
	}

	assassin: {
		Name: Assassin
		Effect: +12% rogue damage, +6% rogue critical strike chance; −10% max life
	}

	trickster: {
		Name: Trickster
		Effect: +15% rogue attack speed, +10% movement speed; −6% rogue damage
	}

	ambush: {
		Name: Ambush
		Effect: Your first rogue hit against an enemy at full life deals +50% damage
	}

	shadow: {
		Name: Shadow
		Effect: Unlocks In the Shadows: a hit from the shadows deals +25% damage and always critically strikes
	}

	juggler: {
		Name: Juggler
		Effect: Rogue hits grant a stack of +3% rogue attack speed for 3 s, up to 5 stacks
	}

	evasion: {
		Name: Evasion
		Effect: 10% chance to completely evade a hit; 5 s cooldown
	}

	executioner: {
		Name: Executioner
		Effect: +30% rogue damage against enemies below 30% life
	}

	first_blood: {
		Name: First Blood
		Effect: Ambush inflicts bleeding: 10% of hit damage per second for 5 s
	}

	vanish: {
		Name: Vanish
		Effect: Killing an enemy immediately restores In the Shadows
	}

	dusk_blade: {
		Name: Dusk Blade
		Effect: Hits from the shadows: critical strikes deal ×2.5 instead of ×2 damage and ignore 15 defense
	}

	ricochet: {
		Name: Ricochet
		Effect: At 5 stacks, hits release a shard at the nearest other enemy within 15 tiles for 40% damage, at most 3 times per second
	}

	bravado: {
		Name: Bravado
		Effect: At 5 stacks: +15% movement speed and +10% rogue critical strike chance
	}

	smoke_bomb: {
		Name: Smoke Bomb
		Effect: After evading: 1.5 s of invulnerability and +40% damage on your next rogue hit
	}

	lucky_break: {
		Name: Lucky Break
		Effect: +1% evasion chance per 20 Luck, up to +10%; evading heals 5% max life
	}

	warrior: {
		Name: Warrior
		Effect: +5% melee damage, +20 max life
	}

	berserker: {
		Name: Berserker
		Effect: +12% melee damage and +8% melee speed; −10% damage reduction
	}

	guardian: {
		Name: Guardian
		Effect: +10% max life, +8% damage reduction; −8% melee damage
	}

	blood_rage: {
		Name: Blood Rage
		Effect: Damage grows as you lose life, up to +25% below 30% life
	}

	frenzy: {
		Name: Frenzy
		Effect: Each hit grants a stack of +2% attack speed for 3 s, up to 10 stacks
	}

	iron_flesh: {
		Name: Iron Flesh
		Effect: +1% melee damage per 5 defense, up to +25%
	}

	retribution: {
		Name: Retribution
		Effect: After taking damage, your next hit within 3 s deals +30%
	}

	possessed: {
		Name: Possessed
		Effect: Below 25% life: 3% lifesteal, at most 10 HP/s
	}

	unbreakable: {
		Name: Unbreakable
		Effect: Once per 5 minutes a lethal hit leaves you at 1 HP with 3 s of invulnerability
	}

	whirlwind: {
		Name: Whirlwind
		Effect: At 10 stacks: +15% damage and +15% move speed
	}

	iron_rhythm: {
		Name: Iron Rhythm
		Effect: Stacks last 6 s, max 6; each stack also gives +2% damage
	}

	colossus: {
		Name: Colossus
		Effect: +15% max life; every 100 max life gives +2% damage reduction, up to +10%
	}

	will_shield: {
		Name: Shield of Will
		Effect: 8 s without taking damage creates a shield for 15% max life; knockback immunity
	}

	eye_for_eye: {
		Name: Eye for an Eye
		Effect: Retribution hits heal for 5% of damage dealt
	}

	counterstrike: {
		Name: Counterstrike
		Effect: When hit, enemies within 10 tiles take 100% of that damage, 2 s cooldown
	}

	ranger: {
		Name: Ranger
		Effect: +5% ranged damage, +5% move speed
	}

	sniper: {
		Name: Sniper
		Effect: +10% ranged damage, +8% crit; −12% attack speed
	}

	gunner: {
		Name: Gunner
		Effect: +15% ranged attack speed; −6% crit, −5% damage
	}

	cold_blood: {
		Name: Cold Blood
		Effect: Standing still for 1 s: +15% crit and +10% damage
	}

	long_range: {
		Name: Long Range
		Effect: Damage grows with distance, up to +20% at 40+ tiles
	}

	spin_up: {
		Name: Spin-Up
		Effect: Continuous fire: +2% attack speed per second, up to +20%
	}

	quartermaster: {
		Name: Quartermaster
		Effect: +20% chance not to consume ammo, +8% move speed
	}

	deadshot: {
