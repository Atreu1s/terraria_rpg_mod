	}

	pack_heal: {
		Name: Pack Care
		Effect: Whip hits heal 1 HP per minion, at most once per second
	}

	alpha: {
		Name: Alpha
		Effect: If only one minion type is summoned, +20% damage for them
	}

	sacrifice: {
