Nodes: {
	rogue: {
		Name: Разбойник
		Effect: +5% урона разбойника, +5% крита разбойника
	}

	assassin: {
		Name: Убийца
		Effect: +12% урона, +6% крита разбойника; −10% макс. HP
	}

	trickster: {
		Name: Ловкач
		Effect: +15% скорости атаки разбойника, +10% скорости передвижения; −6% урона разбойника
	}

	ambush: {
		Name: Засада
		Effect: Первый удар разбойника по врагу с полным HP наносит +50%
	}

	shadow: {
		Name: Тень
		Effect: Открывает «В тени»: удар из тени +25% урона и гарантированный крит
	}

	juggler: {
		Name: Жонглёр
		Effect: Попадание разбойника даёт стак +3% скорости атаки разбойника на 3 с, до 5 стаков
	}

	evasion: {
		Name: Уклонение
		Effect: 10% шанс полностью избежать удара, перезарядка 5 с
	}

	executioner: {
		Name: Палач
		Effect: +30% урона разбойника по врагам ниже 30% HP
	}

	first_blood: {
		Name: Первая кровь
		Effect: Удар Засады вешает кровотечение: 10% урона удара в секунду, 5 с
	}

	vanish: {
		Name: Исчезновение
		Effect: Убийство врага сразу возвращает «в тени»
	}

	dusk_blade: {
		Name: Сумеречный клинок
		Effect: Удар из тени: крит ×2,5 вместо ×2 и игнор 15 защиты
	}

	ricochet: {
		Name: Рикошет
		Effect: На 5 стаках попадание выпускает осколок в ближайшего другого врага в 15 блоках на 40% урона, не чаще 3 раз в секунду
	}

	bravado: {
		Name: Кураж
		Effect: На 5 стаках: +15% скорости передвижения и +10% крита разбойника
	}

	smoke_bomb: {
		Name: Дымовая шашка
		Effect: После уклонения: 1,5 с неуязвимости и следующий удар разбойника +40%
	}

	lucky_break: {
		Name: Счастливый случай
		Effect: +1% шанса уклонения за каждые 20 Удачи, до +10%; уклонение лечит 5% макс. HP
	}

	warrior: {
		Name: Воин
		Effect: +5% урона ближнего боя, +20 HP
	}

	berserker: {
		Name: Берсерк
		Effect: +12% урона и +8% скорости атаки ближнего боя; −10% снижения урона
	}

	guardian: {
		Name: Страж
		Effect: +10% HP, +8% снижения урона; −8% урона ближнего боя
	}

	blood_rage: {
		Name: Кровавая ярость
		Effect: Урон растёт по мере потери HP, до +25% при HP ниже 30%
	}

